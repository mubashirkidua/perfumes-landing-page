# Production site URL (no trailing slash) — used for SEO canonical/OG links.
# Set to your real domain before going live, e.g. https://www.yourstore.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel login password
# Set a strong password before going live.
ADMIN_PASSWORD=ocean-admin-2026

# Secret used to sign the admin session cookie (HMAC).
# MUST be changed to a long random value in production.
ADMIN_SESSION_SECRET=ocean-session-secret-change-me
